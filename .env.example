# Copy to .env.local (git-ignored). Every value is optional.
#
# Browser side (VITE_* values end up in the JavaScript bundle, so no secrets here):
# VITE_AI_PROVIDER   mock | http        (default: mock: deterministic, offline, no key needed)
# VITE_AI_ENDPOINT   where the http provider posts; default /api/ai/complete, which
#                    Vite proxies to `npm run server`
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=

# Server side, read only by `npm run server` (server/index.mjs). Never sent to the browser.
# XAI_API_KEY        your xAI key (never commit a real key)
# XAI_MODEL          default grok-4.7
# XAI_BASE_URL       default https://api.x.ai/v1
# AI_SERVER_PORT     default 8787
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=
AI_SERVER_PORT=
